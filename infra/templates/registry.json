{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Santander - Registry com providers IaC e papéis separados",
  "Parameters": {
    "Project": {
      "Type": "String",
      "Default": "santander-demo"
    },
    "ArtifactBucket": {
      "Type": "String"
    },
    "ProviderKey": {
      "Type": "String"
    },
    "GatewayUrl": {
      "Type": "String"
    },
    "OperatorRoleArn": {
      "Type": "String"
    },
    "SupervisorRoleArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "RegistryProviderRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/*:log-stream:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateRegistry",
                    "bedrock-agentcore:GetRegistry",
                    "bedrock-agentcore:DeleteRegistry"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "RegistryProviderLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Project}-registry-provider"
        },
        "RetentionInDays": 7
      }
    },
    "RegistryProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Project}-registry-provider"
        },
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Timeout": 600,
        "MemorySize": 256,
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "RegistryProviderRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ProviderKey"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Registry"
          }
        }
      },
      "DependsOn": "RegistryProviderLog"
    },
    "RecordProviderRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/*:log-stream:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateRegistryRecord",
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:DeleteRegistryRecord",
                    "bedrock-agentcore:SubmitRegistryRecordForApproval"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "RecordProviderLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Project}-record-provider"
        },
        "RetentionInDays": 7
      }
    },
    "RecordProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Project}-record-provider"
        },
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Timeout": 600,
        "MemorySize": 256,
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "RecordProviderRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ProviderKey"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Record"
          }
        }
      },
      "DependsOn": "RecordProviderLog"
    },
    "ApprovalProviderRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/*:log-stream:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:UpdateRegistryRecordStatus"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApprovalProviderLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Project}-approval-provider"
        },
        "RetentionInDays": 7
      }
    },
    "ApprovalProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Project}-approval-provider"
        },
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Timeout": 600,
        "MemorySize": 256,
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "ApprovalProviderRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ProviderKey"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Approval"
          }
        }
      },
      "DependsOn": "ApprovalProviderLog"
    },
    "Catalog": {
      "Type": "Custom::AgentCoreRegistry",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "RegistryProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Registry",
        "Name": {
          "Ref": "Project"
        }
      }
    },
    "PublisherRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${Project}-registry-publisher"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  {
                    "Ref": "OperatorRoleArn"
                  }
                ]
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Publisher",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistry",
                    "bedrock-agentcore:ListRegistryRecords",
                    "bedrock-agentcore:CreateRegistryRecord",
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:SubmitRegistryRecordForApproval"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Catalog",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${Catalog.Arn}/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApproverRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${Project}-registry-approver"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  {
                    "Ref": "OperatorRoleArn"
                  }
                ]
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Approver",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistry",
                    "bedrock-agentcore:ListRegistryRecords",
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:UpdateRegistryRecordStatus"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Catalog",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${Catalog.Arn}/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ConsumerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${Project}-registry-consumer"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  {
                    "Ref": "OperatorRoleArn"
                  },
                  {
                    "Ref": "SupervisorRoleArn"
                  }
                ]
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Consumer",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistry",
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:SearchRegistryRecords"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Catalog",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${Catalog.Arn}/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
