{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Santander 12 - catalog ownership, review and cross-account discovery",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "Project": {
      "Type": "String",
      "Default": "santander-journey"
    },
    "GatewayUrl": {
      "Type": "String"
    },
    "OriginAccount": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}"
    },
    "ApproveRecords": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Resources": {
    "RegistryLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "${AWS::StackName}-registry"
        },
        "RetentionInDays": 7
      }
    },
    "RegistryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RegistryLog",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistry",
                    "bedrock-agentcore:DeleteRegistry"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateRegistry"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RegistryProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 600,
        "Role": {
          "Fn::GetAtt": [
            "RegistryRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "RegistryLog"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Registry"
          }
        }
      }
    },
    "RecordLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "${AWS::StackName}-record"
        },
        "RetentionInDays": 7
      }
    },
    "RecordRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RecordLog",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateRegistryRecord",
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:DeleteRegistryRecord",
                    "bedrock-agentcore:SubmitRegistryRecordForApproval"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "RecordProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 600,
        "Role": {
          "Fn::GetAtt": [
            "RecordRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "RecordLog"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Record"
          }
        }
      }
    },
    "ApprovalLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "${AWS::StackName}-approval"
        },
        "RetentionInDays": 7
      }
    },
    "ApprovalRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApprovalLog",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetRegistryRecord",
                    "bedrock-agentcore:UpdateRegistryRecordStatus"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:registry/*/record/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApprovalProvider": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "registry_handler.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 600,
        "Role": {
          "Fn::GetAtt": [
            "ApprovalRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ApprovalLog"
          }
        },
        "Environment": {
          "Variables": {
            "RESOURCE_KIND": "Approval"
          }
        }
      }
    },
    "Catalog": {
      "Type": "Custom::AgentCoreRegistry",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "RegistryProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Registry",
        "Name": {
          "Ref": "Project"
        }
      }
    },
    "RiscosRecord": {
      "Type": "Custom::AgentCoreRegistryRecord",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "RecordProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Record",
        "RegistryId": {
          "Fn::GetAtt": [
            "Catalog",
            "Id"
          ]
        },
        "Name": "riscos",
        "Description": "Santander riscos; owner=dados; instance managed by IaC",
        "Version": "1.0.0",
        "Submit": "true",
        "Descriptors": {
          "mcp": {
            "server": {
              "schemaVersion": "2025-12-11",
              "inlineContent": {
                "Fn::Sub": "{\"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\", \"name\": \"com.santander.demo/riscos\", \"description\": \"Santander riscos canary DBSQL\", \"version\": \"1.0.0\", \"remotes\": [{\"type\": \"streamable-http\", \"url\": \"${GatewayUrl}\"}], \"_meta\": {\"com.santander/owner\": \"dados\", \"com.santander/instance\": \"${Project}\"}}"
              }
            },
            "tools": {
              "protocolVersion": "2025-11-25",
              "inlineContent": "{\"tools\": [{\"name\": \"dados___riscos___execute_sql\", \"description\": \"Execute only the identity probe or the approved read-only canary query.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}}]}"
            }
          }
        }
      }
    },
    "RiscosRecordApproval": {
      "Type": "Custom::AgentCoreRegistryApproval",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "ApprovalProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Approval",
        "RegistryId": {
          "Fn::GetAtt": [
            "Catalog",
            "Id"
          ]
        },
        "RecordId": {
          "Fn::GetAtt": [
            "RiscosRecord",
            "Id"
          ]
        },
        "Decision": "APPROVED"
      },
      "Condition": "ApproveRecords"
    },
    "FraudeRecord": {
      "Type": "Custom::AgentCoreRegistryRecord",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "RecordProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Record",
        "RegistryId": {
          "Fn::GetAtt": [
            "Catalog",
            "Id"
          ]
        },
        "Name": "fraude",
        "Description": "Santander fraude; owner=dados; instance managed by IaC",
        "Version": "1.0.0",
        "Submit": "true",
        "Descriptors": {
          "mcp": {
            "server": {
              "schemaVersion": "2025-12-11",
              "inlineContent": {
                "Fn::Sub": "{\"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\", \"name\": \"com.santander.demo/fraude\", \"description\": \"Santander fraude canary DBSQL\", \"version\": \"1.0.0\", \"remotes\": [{\"type\": \"streamable-http\", \"url\": \"${GatewayUrl}\"}], \"_meta\": {\"com.santander/owner\": \"dados\", \"com.santander/instance\": \"${Project}\"}}"
              }
            },
            "tools": {
              "protocolVersion": "2025-11-25",
              "inlineContent": "{\"tools\": [{\"name\": \"dados___fraude___execute_sql\", \"description\": \"Execute only the identity probe or the approved read-only canary query.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}}]}"
            }
          }
        }
      }
    },
    "FraudeRecordApproval": {
      "Type": "Custom::AgentCoreRegistryApproval",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "ApprovalProvider",
            "Arn"
          ]
        },
        "ServiceTimeout": 650,
        "Kind": "Approval",
        "RegistryId": {
          "Fn::GetAtt": [
            "Catalog",
            "Id"
          ]
        },
        "RecordId": {
          "Fn::GetAtt": [
            "FraudeRecord",
            "Id"
          ]
        },
        "Decision": "APPROVED"
      },
      "Condition": "ApproveRecords"
    },
    "ConsumerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${OriginAccount}:root"
                }
              },
              "Condition": {
                "ArnEquals": {
                  "aws:PrincipalArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${OriginAccount}:role/${Project}-riscos-runtime"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${OriginAccount}:role/${Project}-fraude-runtime"
                    }
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:SearchRegistryRecords"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Catalog",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "RoleName": {
          "Fn::Sub": "${Project}-catalog-consumer"
        }
      }
    }
  },
  "Outputs": {
    "RegistryArn": {
      "Value": {
        "Fn::GetAtt": [
          "Catalog",
          "Arn"
        ]
      }
    },
    "RegistryId": {
      "Value": {
        "Fn::GetAtt": [
          "Catalog",
          "Id"
        ]
      }
    },
    "RegistryConsumerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ConsumerRole",
          "Arn"
        ]
      }
    }
  },
  "Conditions": {
    "ApproveRecords": {
      "Fn::Equals": [
        {
          "Ref": "ApproveRecords"
        },
        "true"
      ]
    }
  }
}
