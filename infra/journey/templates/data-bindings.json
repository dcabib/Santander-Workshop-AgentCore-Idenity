{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Santander 12 - data targets and user/agent/tool policies",
  "Parameters": {
    "GatewayId": {
      "Type": "String"
    },
    "GatewayArn": {
      "Type": "String"
    },
    "PolicyEngineId": {
      "Type": "String"
    },
    "OAuthProviderArn": {
      "Type": "String"
    },
    "TenantId": {
      "Type": "String",
      "AllowedPattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
    },
    "AllowedUserOids": {
      "Type": "String",
      "AllowedPattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(,[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})*"
    },
    "CallerClientId": {
      "Type": "String",
      "AllowedPattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
    },
    "DatabricksMcpUrl": {
      "Type": "String",
      "AllowedPattern": "https://adb-[0-9]+\\.[0-9]+\\.azuredatabricks\\.net/.*"
    },
    "DatabricksScope": {
      "Type": "String",
      "Default": "all-apis",
      "AllowedValues": [
        "all-apis",
        "sql",
        "ai-gateway"
      ]
    },
    "RiscosTable": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "FraudeTable": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*"
    }
  },
  "Resources": {
    "RiscosTarget": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {
          "Ref": "GatewayId"
        },
        "Name": "riscos",
        "TargetConfiguration": {
          "Mcp": {
            "McpServer": {
              "Endpoint": {
                "Ref": "DatabricksMcpUrl"
              },
              "McpToolSchema": {
                "InlinePayload": "{\"tools\": [{\"name\": \"execute_sql\", \"description\": \"Execute only the identity probe or the approved read-only canary query.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}}]}"
              }
            }
          }
        },
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "OAUTH",
            "CredentialProvider": {
              "OauthCredentialProvider": {
                "ProviderArn": {
                  "Ref": "OAuthProviderArn"
                },
                "Scopes": [
                  {
                    "Ref": "DatabricksScope"
                  }
                ],
                "GrantType": "TOKEN_EXCHANGE",
                "CustomParameters": {
                  "requested_token_type": "urn:ietf:params:oauth:token-type:access_token"
                }
              }
            }
          }
        ]
      }
    },
    "FraudeTarget": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {
          "Ref": "GatewayId"
        },
        "Name": "fraude",
        "TargetConfiguration": {
          "Mcp": {
            "McpServer": {
              "Endpoint": {
                "Ref": "DatabricksMcpUrl"
              },
              "McpToolSchema": {
                "InlinePayload": "{\"tools\": [{\"name\": \"execute_sql\", \"description\": \"Execute only the identity probe or the approved read-only canary query.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}}]}"
              }
            }
          }
        },
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "OAUTH",
            "CredentialProvider": {
              "OauthCredentialProvider": {
                "ProviderArn": {
                  "Ref": "OAuthProviderArn"
                },
                "Scopes": [
                  {
                    "Ref": "DatabricksScope"
                  }
                ],
                "GrantType": "TOKEN_EXCHANGE",
                "CustomParameters": {
                  "requested_token_type": "urn:ietf:params:oauth:token-type:access_token"
                }
              }
            }
          }
        ]
      }
    },
    "RiscosDelegated": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "Properties": {
        "Name": "RiscosDelegated",
        "PolicyEngineId": {
          "Ref": "PolicyEngineId"
        },
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": [
                "permit(\n  principal is AgentCore::OAuthUser,\n  action == AgentCore::Action::\"riscos___execute_sql\",\n  resource == AgentCore::Gateway::\"${GatewayArn}\"\n)\nwhen {\n  principal.hasTag(\"tid\") && principal.getTag(\"tid\") == \"${TenantId}\" &&\n  principal.hasTag(\"azp\") && principal.getTag(\"azp\") == \"${CallerClientId}\" &&\n  principal.hasTag(\"oid\") && [\"${UserList}\"].contains(principal.getTag(\"oid\")) &&\n  principal.hasTag(\"ver\") && principal.getTag(\"ver\") == \"2.0\" &&\n  principal.hasTag(\"scp\") && principal.getTag(\"scp\") == \"access_as_user\" &&\n  [\"SELECT current_user() AS principal\", \"SELECT current_user() AS principal, COUNT(*) AS total FROM ${RiscosTable}\"].contains(context.input.query)\n};",
                {
                  "UserList": {
                    "Fn::Join": [
                      "\", \"",
                      {
                        "Fn::Split": [
                          ",",
                          {
                            "Ref": "AllowedUserOids"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "ValidationMode": "FAIL_ON_ANY_FINDINGS",
        "EnforcementMode": "ACTIVE"
      },
      "DependsOn": [
        "RiscosTarget",
        "FraudeTarget"
      ]
    },
    "FraudeDelegated": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "Properties": {
        "Name": "FraudeDelegated",
        "PolicyEngineId": {
          "Ref": "PolicyEngineId"
        },
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": [
                "permit(\n  principal is AgentCore::OAuthUser,\n  action == AgentCore::Action::\"fraude___execute_sql\",\n  resource == AgentCore::Gateway::\"${GatewayArn}\"\n)\nwhen {\n  principal.hasTag(\"tid\") && principal.getTag(\"tid\") == \"${TenantId}\" &&\n  principal.hasTag(\"azp\") && principal.getTag(\"azp\") == \"${CallerClientId}\" &&\n  principal.hasTag(\"oid\") && [\"${UserList}\"].contains(principal.getTag(\"oid\")) &&\n  principal.hasTag(\"ver\") && principal.getTag(\"ver\") == \"2.0\" &&\n  principal.hasTag(\"scp\") && principal.getTag(\"scp\") == \"access_as_user\" &&\n  [\"SELECT current_user() AS principal\", \"SELECT current_user() AS principal, COUNT(*) AS total FROM ${FraudeTable}\"].contains(context.input.query)\n};",
                {
                  "UserList": {
                    "Fn::Join": [
                      "\", \"",
                      {
                        "Fn::Split": [
                          ",",
                          {
                            "Ref": "AllowedUserOids"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "ValidationMode": "FAIL_ON_ANY_FINDINGS",
        "EnforcementMode": "ACTIVE"
      },
      "DependsOn": [
        "RiscosTarget",
        "FraudeTarget"
      ]
    }
  },
  "Outputs": {}
}
