{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Workshop AWS - CodeBuild notebook execution with private source and evidence",
  "Parameters": {
    "Project": {
      "Type": "String"
    },
    "ArtifactBucket": {
      "Type": "String"
    },
    "SourceKey": {
      "Type": "String"
    },
    "SecretArns": {
      "Type": "CommaDelimitedList"
    },
    "ControlArns": {
      "Type": "CommaDelimitedList"
    },
    "KnowledgeArns": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "SourceArns": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "LogArns": {
      "Type": "CommaDelimitedList"
    },
    "AssumeRoleArns": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "PersonaArns": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "TerraformPoolArn": {
      "Type": "String",
      "Default": ""
    },
    "GatewayRoleArn": {
      "Type": "String"
    },
    "Labs": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "[0-9 ]*"
    }
  },
  "Resources": {
    "Log": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:codebuild:${AWS::Region}:${AWS::AccountId}:project/${Project}-notebooks"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Log.Arn}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/source/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/evidence/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation",
                    "s3:GetBucketAcl"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${Project}-*/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/santander-rag-rag-*/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/registry-personas-*/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "SecretArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetGateway",
                    "bedrock-agentcore:GetGatewayTarget",
                    "bedrock-agentcore:ListGatewayTargets",
                    "bedrock-agentcore:GetAgentRuntime",
                    "bedrock-agentcore:GetMemory",
                    "bedrock-agentcore:GetWorkloadIdentity",
                    "bedrock-agentcore:GetResourcePolicy",
                    "bedrock-agentcore:GetPolicyGeneration",
                    "bedrock-agentcore:GetPolicy",
                    "bedrock-agentcore:ListPolicyGenerationAssets",
                    "bedrock-agentcore:ListPolicies",
                    "bedrock-agentcore:GetPolicyEngine",
                    "bedrock-agentcore:GetWorkloadAccessToken",
                    "bedrock-agentcore:GetResourceOauth2Token",
                    "bedrock-agentcore:InvokeAgentRuntime"
                  ],
                  "Resource": {
                    "Ref": "ControlArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetWorkloadIdentity",
                    "bedrock-agentcore:GetWorkloadAccessToken"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole"
                  ],
                  "Resource": {
                    "Ref": "GatewayRoleArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:FilterLogEvents",
                    "logs:GetLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Ref": "LogArns"
                  }
                },
                {
                  "Fn::If": [
                    "HasAssumeRoleArns",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "sts:AssumeRole"
                      ],
                      "Resource": {
                        "Ref": "AssumeRoleArns"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasPersonaArns",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "iam:SimulatePrincipalPolicy"
                      ],
                      "Resource": {
                        "Ref": "PersonaArns"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasTerraformPoolArn",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "cognito-idp:DescribeUserPoolClient"
                      ],
                      "Resource": {
                        "Ref": "TerraformPoolArn"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasKnowledgeArns",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "bedrock:GetKnowledgeBase",
                        "bedrock:GetDataSource",
                        "bedrock:GetIngestionJob"
                      ],
                      "Resource": {
                        "Ref": "KnowledgeArns"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasSourceArns",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "s3:GetObject"
                      ],
                      "Resource": {
                        "Ref": "SourceArns"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Runner": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Project}-notebooks"
        },
        "ServiceRole": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "TimeoutInMinutes": 60,
        "QueuedTimeoutInMinutes": 15,
        "Source": {
          "Type": "S3",
          "Location": {
            "Fn::Sub": "${ArtifactBucket}/${SourceKey}"
          },
          "BuildSpec": "{\"version\": 0.2, \"phases\": {\"install\": {\"runtime-versions\": {\"python\": \"3.12\"}, \"commands\": [\"python -m pip install uv==0.9.7\", \"uv sync --frozen --extra banking\", \"uv run python -m ipykernel install --user --name python3\"]}, \"build\": {\"commands\": [\"uv run python scripts/verify_notebooks.py ${WORKSHOP_LABS:+--labs $WORKSHOP_LABS}\"]}}, \"artifacts\": {\"files\": [\"evidence/notebooks-aws.json\", \"evidence/workshop-prerequisites.json\", \"evidence/executed/*.ipynb\"], \"discard-paths\": false}}"
        },
        "Artifacts": {
          "Type": "S3",
          "Location": {
            "Ref": "ArtifactBucket"
          },
          "Path": "evidence",
          "NamespaceType": "BUILD_ID",
          "Name": "notebooks.zip",
          "Packaging": "ZIP"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": false,
          "EnvironmentVariables": [
            {
              "Name": "WORKSHOP_CONFIG",
              "Value": "config/aws.workshop.json"
            },
            {
              "Name": "WORKSHOP_LABS",
              "Value": {
                "Ref": "Labs"
              }
            }
          ]
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "Log"
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ProjectName": {
      "Value": {
        "Ref": "Runner"
      }
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "Role",
          "Arn"
        ]
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Log"
      }
    }
  },
  "Conditions": {
    "HasAssumeRoleArns": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "AssumeRoleArns"
                }
              ]
            },
            ""
          ]
        }
      ]
    },
    "HasPersonaArns": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "PersonaArns"
                }
              ]
            },
            ""
          ]
        }
      ]
    },
    "HasTerraformPoolArn": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "TerraformPoolArn"
            },
            ""
          ]
        }
      ]
    },
    "HasKnowledgeArns": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "KnowledgeArns"
                }
              ]
            },
            ""
          ]
        }
      ]
    },
    "HasSourceArns": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "SourceArns"
                }
              ]
            },
            ""
          ]
        }
      ]
    }
  }
}
