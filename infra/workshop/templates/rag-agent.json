{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Workshop AWS - RAG inference in Runtime with native managed KB ACLs",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "Issuer": {
      "Type": "String"
    },
    "RuntimeName": {
      "Type": "String"
    },
    "GatewayUrl": {
      "Type": "String"
    },
    "LoginClientId": {
      "Type": "String"
    },
    "ModelArn": {
      "Type": "String"
    },
    "RagConfig": {
      "Type": "String"
    },
    "SourceBucket": {
      "Type": "String"
    },
    "KnowledgeBaseId": {
      "Type": "String"
    }
  },
  "Resources": {
    "Workload": {
      "Type": "AWS::BedrockAgentCore::WorkloadIdentity",
      "Properties": {
        "Name": {
          "Fn::Sub": "${RuntimeName}_workload"
        }
      }
    },
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "workshop",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${ArtifactKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:DescribeLogStreams",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": {
                    "Ref": "ModelArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetWorkloadAccessTokenForJWT"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Workload",
                        "WorkloadIdentityArn"
                      ]
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default"
                    }
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "bedrock:Retrieve",
                    "bedrock:RetrieveAndGenerate",
                    "bedrock:AgenticRetrieveStream"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Runtime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "Properties": {
        "AgentRuntimeName": {
          "Ref": "RuntimeName"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "RuntimeRole",
            "Arn"
          ]
        },
        "AgentRuntimeArtifact": {
          "CodeConfiguration": {
            "Runtime": "PYTHON_3_12",
            "EntryPoint": [
              "workshop_rag_main.py"
            ],
            "Code": {
              "S3": {
                "Bucket": {
                  "Ref": "ArtifactBucket"
                },
                "Prefix": {
                  "Ref": "ArtifactKey"
                }
              }
            }
          }
        },
        "ProtocolConfiguration": "HTTP",
        "NetworkConfiguration": {
          "NetworkMode": "PUBLIC"
        },
        "AuthorizerConfiguration": {
          "CustomJWTAuthorizer": {
            "DiscoveryUrl": {
              "Fn::Sub": "${Issuer}/.well-known/openid-configuration"
            },
            "AllowedAudience": [
              {
                "Ref": "LoginClientId"
              }
            ],
            "CustomClaims": [
              {
                "InboundTokenClaimName": "token_use",
                "InboundTokenClaimValueType": "STRING",
                "AuthorizingClaimMatchValue": {
                  "ClaimMatchOperator": "EQUALS",
                  "ClaimMatchValue": {
                    "MatchValueString": "id"
                  }
                }
              }
            ]
          }
        },
        "RequestHeaderConfiguration": {
          "RequestHeaderAllowlist": [
            "Authorization"
          ]
        },
        "EnvironmentVariables": {
          "WORKSHOP_RAG_CONFIG": {
            "Ref": "RagConfig"
          },
          "WORKSHOP_RAG_ENVIRONMENT": {
            "Fn::Sub": "{\"GatewayUrl\": \"${GatewayUrl}\", \"SourceBucket\": \"${SourceBucket}\", \"KnowledgeBaseId\": \"${KnowledgeBaseId}\", \"WorkloadName\": \"${RuntimeName}_workload\"}"
          }
        },
        "LifecycleConfiguration": {
          "IdleRuntimeSessionTimeout": 60,
          "MaxLifetime": 900
        }
      }
    }
  },
  "Outputs": {
    "RuntimeArn": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeArn"
        ]
      }
    },
    "RuntimeId": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeId"
        ]
      }
    },
    "WorkloadName": {
      "Value": {
        "Fn::Sub": "${RuntimeName}_workload"
      }
    },
    "WorkloadArn": {
      "Value": {
        "Fn::GetAtt": [
          "Workload",
          "WorkloadIdentityArn"
        ]
      }
    }
  }
}
