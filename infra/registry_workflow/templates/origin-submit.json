{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Registry personas - submeter para revisao",
  "Parameters": {
    "RegistryId": {
      "Type": "String"
    },
    "PublisherProviderArn": {
      "Type": "String"
    },
    "RiscosRecordId": {
      "Type": "String"
    },
    "FraudeRecordId": {
      "Type": "String"
    }
  },
  "Resources": {
    "Riscos": {
      "Type": "Custom::RegistrySubmission",
      "Properties": {
        "ServiceToken": {
          "Ref": "PublisherProviderArn"
        },
        "Kind": "Submission",
        "RegistryId": {
          "Ref": "RegistryId"
        },
        "RecordId": {
          "Ref": "RiscosRecordId"
        }
      }
    },
    "Fraude": {
      "Type": "Custom::RegistrySubmission",
      "Properties": {
        "ServiceToken": {
          "Ref": "PublisherProviderArn"
        },
        "Kind": "Submission",
        "RegistryId": {
          "Ref": "RegistryId"
        },
        "RecordId": {
          "Ref": "FraudeRecordId"
        }
      }
    }
  },
  "Outputs": {}
}
